rules_version = '2';

// GoJob Firestore security rules.
//
// All privileged reads/writes go through the server (Admin SDK), which bypasses
// these rules. The client SDK is only trusted for: reading your own user &
// candidate docs, and the realtime chat between the two matched participants.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isParticipant(parts) {
      return signedIn() && request.auth.uid in parts;
    }

    // A user can read (not write) their own user document.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
    }

    // Notification summaries are durable user data (not TTL candidates).
    match /userStats/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // A candidate can read their own profile. Employers view candidates via the
    // server, so no broad client read here.
    match /candidates/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
    }

    // Realtime chat: participants can read conversations and messages. All
    // conversation writes are server-side so clients cannot alter identity,
    // authorization, or metadata fields (including participants and match/job
    // ownership). Clients may only create a strictly shaped message.
    match /conversations/{cid} {
      allow read: if isParticipant(resource.data.participants);
      allow create, update, delete: if false;

      match /messages/{mid} {
        allow read: if isParticipant(
          get(/databases/$(database)/documents/conversations/$(cid)).data.participants
        );
        allow create: if isParticipant(
                        get(/databases/$(database)/documents/conversations/$(cid)).data.participants
                      )
                      && request.resource.data.keys().hasAll([
                        'conversationId', 'senderId', 'body', 'createdAt', 'readAt'
                      ])
                      && request.resource.data.keys().hasOnly([
                        'conversationId', 'senderId', 'body', 'createdAt', 'readAt'
                      ])
                      && request.resource.data.conversationId is string
                      && request.resource.data.conversationId == cid
                      && request.resource.data.senderId is string
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.body is string
                      && request.resource.data.body.size() > 0
                      && request.resource.data.body.size() <= 4000
                      && request.resource.data.createdAt is string
                      && request.resource.data.readAt == null;
        allow update, delete: if false;
      }
    }

    // Deny everything else on the client (server uses the Admin SDK).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
