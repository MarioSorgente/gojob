# ---------------------------------------------------------------------------
# GoJob environment
# ---------------------------------------------------------------------------
# For LOCAL development you do NOT need a real Firebase project. Copy this file
# to `.env.local`, keep the emulator flag on, and run `npm run emulators`
# alongside `npm run dev`. The dummy values below work against the emulator.
#
# For PRODUCTION (Vercel), create a Firebase project, enable Auth
# (Email/Password, Google, Phone), Firestore, and Storage, then replace the
# NEXT_PUBLIC_* values with your web app config, set a service account, and set
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR=0.
# ---------------------------------------------------------------------------

# Public Firebase web config (safe to expose to the browser).
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-gojob.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-gojob
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-gojob.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demogojob

# Point the client + admin SDKs at the local Firebase Emulator Suite.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=1
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=localhost

# --- Server / Firebase Admin ---
FIREBASE_ADMIN_PROJECT_ID=demo-gojob

# When these are set, the Admin SDK talks to the emulators (no credentials
# needed). Comment them out in production.
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# PRODUCTION ONLY: base64-encoded service account JSON (leave blank for emulator).
# Generate: base64 -w0 serviceAccount.json  (or use GOOGLE_APPLICATION_CREDENTIALS)
FIREBASE_SERVICE_ACCOUNT_KEY=
