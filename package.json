{
  "name": "gojob",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "emulators": "npx --yes firebase-tools emulators:start --project demo-gojob",
    "seed": "tsx scripts/seed.ts",
    "seed:prod": "tsx scripts/seed.ts --prod",
    "format": "prettier --write ."
  },
  "overrides": {
    "jose": "^5.10.0"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "next": "16.3.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
