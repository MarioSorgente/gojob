{
  "name": "gojob",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-gojob-rules \"vitest run --config firestore.rules.vitest.config.mts\"",
    "test:watch": "vitest",
    "emulators": "npx --yes firebase-tools emulators:start --project demo-gojob",
    "seed": "tsx scripts/seed.ts",
    "seed:prod": "tsx scripts/seed.ts --prod",
    "migrate:conversation-activity": "tsx scripts/backfill-conversation-activity.ts",
    "migrate:conversation-activity:prod": "tsx scripts/backfill-conversation-activity.ts --prod",
    "migrate:unread-stats": "tsx scripts/backfill-unread-conversation-stats.ts",
    "migrate:unread-stats:prod": "tsx scripts/backfill-unread-conversation-stats.ts --prod",
    "migrate:job-counts": "tsx scripts/backfill-job-counts.ts",
    "migrate:job-counts:prod": "tsx scripts/backfill-job-counts.ts --prod",
    "migrate:invitation-counts": "tsx scripts/backfill-pending-invitation-counts.ts",
    "migrate:invitation-counts:prod": "tsx scripts/backfill-pending-invitation-counts.ts --prod",
    "format": "prettier --write .",
    "design:audit": "tsx scripts/design-audit.mjs",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report e2e-report"
  },
  "overrides": {
    "jose": "^5.10.0"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "next": "16.3.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "firebase-tools": "^15.26.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
